# Supabase (필수) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude API (선택) — 없으면 AI 기능은 '연동 준비 중'으로 표시됩니다
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# ChatGPT 연결 (MCP 커넥터) — 둘 다 있어야 켜집니다. 서버 전용 값이니 NEXT_PUBLIC_ 을 붙이지 마세요.
# Supabase → Project Settings → API Keys 의 secret(service_role) 키
SUPABASE_SERVICE_ROLE_KEY=
# 32자 이상 아무 임의 문자열 (바꾸면 모든 ChatGPT 연결이 끊김)
MCP_AUTH_SECRET=
